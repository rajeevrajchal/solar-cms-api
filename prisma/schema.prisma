// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  WORKER
  CUSTOMER
  ENGINEER
  PROJECT_MANAGER
  SALE
}

enum ProjectStatus {
  NEW
  SITE_SURVEY
  CUSTOMER_INQUIRY
  DESIGN_IN_PROGRESS
  CUSTOMER_READY
  INSTALLATION_IN_PROGRESS
  ONLINE
  EQUIPMENT_SELECTION
}

enum ProjectType {
  SOLAR
  WIND
  HYDRO
  TIDAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  RESOURCE_BLOCKED
  COMPLETE
}

enum InventoryStatus {
  DRAFT
  ACTIVE
  REMOVED
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  ORDERED
  CANALED
  PENDING
  ON_HOLD
  PAYMENT_DONE
}

model User {
  id       String  @id @unique @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(ENGINEER)
  type     String?
  location String?
  phone    String?

  otp           String?
  refresh_token String?
  reset_token   String?
  is_active     Boolean @default(false)
  is_temp       Boolean @default(false)

  otp_expiry DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  team           UserToTeam[]
  project        Project[]         @relation("customer_project")
  creator        Project[]         @relation("creator_project")
  engineer       Project[]         @relation("engineer_project")
  sale_user      Project[]         @relation("sale_user")
  customer_quote Quote[]           @relation("customer_quote")
  creator_quote  Quote[]           @relation("creator_quote")
  services       CustomerService[] @relation("services")

  @@map("users")
}

model Team {
  id    String @id @unique @default(uuid())
  name  String
  point Int?   @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  users   UserToTeam[]
  project ProjectToTeam[]

  @@map("teams")
}

model UserToTeam {
  user    User   @relation(fields: [user_id], references: [id])
  user_id String
  team    Team   @relation(fields: [team_id], references: [id])
  team_id String

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@id([user_id, team_id])
  @@map("user_team_pivot")
}

model ElectricLoad {
  id            String  @id @unique @default(uuid())
  name          String
  watt          Float
  quantity      Int
  hour          Float
  watt_per_hour Float
  project_id    String
  project       Project @relation(fields: [project_id], references: [id])

  @@map("customer_electric_load")
}

model Project {
  id                     String   @id @unique @default(uuid())
  code                   Int      @unique @default(autoincrement())
  name                   String?
  description            String?
  latitude               Float?
  longitude              Float?
  location               String?
  mark_location_customer Boolean? @default(false)

  type              ProjectType   @default(SOLAR)
  status            ProjectStatus @default(NEW)
  grid_connectivity Boolean @default(false)

  start_date DateTime? @default(now())
  end_date   DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  customer_id  String?
  customer     User?   @relation("customer_project", fields: [customer_id], references: [id])
  creator      User?   @relation("creator_project", fields: [creator_id], references: [id])
  creator_id   String
  engineer     User?   @relation("engineer_project", fields: [engineer_id], references: [id])
  engineer_id  String?
  sale_user    User?   @relation("sale_user", fields: [sale_user_id], references: [id])
  sale_user_id String?
  parent_id    String?

  parent       Project?     @relation("parent_child", fields: [parent_id], references: [id])
  children     Project[]    @relation("parent_child")
  project_info ProjectInfo? @relation("project_info")

  services      ProjectSerivce[]
  team          ProjectToTeam[]
  equipment     Equipment[]
  electric_load ElectricLoad[]
  quote         Quote[]
  model         ProjectModel[]

  @@map("project")
}

model ProjectInfo {
  id String @id @unique @default(uuid())

  area Float?

  power_out_watt      Float?
  power_out_voltage   Float?
  reserve_power_for   Float?
  electrical_capacity Float?

  // tidal
  tidal_range          Float?
  tidal_currents       Float?
  tidal_cycle_duration Float?
  bathymetry_data      String?
  water_density        Float?
  seabed_conditions    String?

  // hydro
  flow_rate            Float?
  head                 Float?
  reservoir_capacity   Float?
  water_quality        String?
  environmental_impact String?

  // solar
  orientation      String?
  shading_factors  Float?
  solar_irradiance Float?
  temperature_data String?
  tilt_angle       Float?
  panel_type       String?

  // wind
  terrain_elevation Float?
  terrain_roughness String?
  obstacle_data     String?
  wind_measurements Json?

  environmental_data String?

  project    Project @relation("project_info", fields: [project_id], references: [id])
  project_id String  @unique

  @@map("project_info")
}

model ProjectSerivce {
  id String @id @unique @default(uuid())

  project    Project? @relation(fields: [project_id], references: [id])
  project_id String?

  @@map("project_services")
}

model ProjectModel {
  id        String  @id @unique @default(uuid())
  model_url String
  image_id  String
  type      String?

  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id String

  @@map("project_model")
}

model ProjectToTeam {
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  project_id String
  team       Team    @relation(fields: [team_id], references: [id], onDelete: Cascade)
  team_id    String

  @@id([project_id, team_id])
  @@map("project_team_pivot")
}

model Quote {
  id                String      @id @unique @default(uuid())
  name              String
  inventory_cost    Float       @default(0)
  net_total         Float       @default(0)
  installation_cost Float       @default(0)
  discount          Float?      @default(0)
  adjustment        Float?      @default(0)
  vat               Float?      @default(0)
  verification_file String?
  status            QuoteStatus @default(PENDING)

  project_id  String
  customer_id String
  customer    User    @relation("customer_quote", fields: [customer_id], references: [id])
  project     Project @relation(fields: [project_id], references: [id])

  created_by String
  creator    User   @relation("creator_quote", fields: [created_by], references: [id])

  order Order[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("quote")
}

model Order {
  id           String      @id @unique @default(uuid())
  name         String?
  reason       String?
  payment      Float?
  full_payment Boolean     @default(false)
  status       OrderStatus @default(PENDING)

  quote_id   String?
  quote      Quote?  @relation(fields: [quote_id], references: [id])
  quote_data Json?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("order")
}

model Vendor {
  id          String  @id @unique @default(uuid())
  name        String
  code        String
  description String?
  email       String?
  phone       String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  inventory Inventory[]
  documents VendorDocument[]

  @@map("vendor")
}

model VendorDocument {
  id          String  @id @unique @default(uuid())
  document    String
  description String?

  vendor_id String
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("vendor_document")
}

model Inventory {
  id   String @id @unique @default(uuid())
  name String

  category      String
  nature        String?
  product_image Json?
  description   String?

  watt    Float?
  voltage Float?
  ampere  Float?

  buying_cost       Float
  selling_cost      Float
  max_flat_discount Float
  max_discount      Float

  status InventoryStatus @default(ACTIVE)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  vendor    Vendor? @relation(fields: [vendor_id], references: [id])
  vendor_id String?

  equipment Equipment[]

  @@map("inventory")
}

model Equipment {
  id          String  @id @unique @default(uuid())
  quantity    Int
  information String?
  component   String
  connection  String? @default("parallel")
  set_name    String?
  voltage     Float?
  ampere      Float?
  watt        Float?

  inventory_id String
  inventory    Inventory @relation(fields: [inventory_id], references: [id])

  project_id String
  project    Project @relation(fields: [project_id], references: [id])

  @@map("equipment")
}

model CustomerService {
  id     String      @id @unique @default(uuid())
  status QuoteStatus
  name   String

  customer_id String
  customer    User   @relation("services", fields: [customer_id], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  service   Service[]

  @@map("customer_service")
}

model Service {
  id          String  @id @unique @default(uuid())
  name        String
  amount      Float
  description String?
  info        Json?

  customer_service_id String
  customer_service    CustomerService? @relation(fields: [customer_service_id], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@map("service")
}
