<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your OTP </title>
  </head>
  <body>
    <div class='container'>
      <h2>Your OTP</h2>
      <p>Your One-Time Password (OTP) is:</p>
