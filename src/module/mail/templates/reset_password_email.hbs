<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Password Email</title>
    <style>
      body { font-family: 'Arial', sans-serif; } .container { max-width: 600px;
      margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); } h2 { color: #007BFF; } p {
      color: #555; } .reset-link { display: inline-block; padding: 10px 15px;
      background-color: #28A745; color: #fff; text-decoration: none;
      border-radius: 3px; }
    </style>
  </head>
  <body>
    <div class='container'>
      <h2>Reset Password Email</h2>
      <p>You have requested to reset your password. Click the link below to
        reset it:</p>
      <a href='{{link}}' class='reset-link'>Reset Password</a>
      <p>If you didn't request this password reset, please ignore this email.</p>
    </div>
  </body>
</html>